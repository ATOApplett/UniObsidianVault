{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build improved",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fopenmp",
                "-O2",
                "-g",
                "${workspaceFolder}\\improved.cpp",
                "-o",
                "${workspaceFolder}\\improved.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}